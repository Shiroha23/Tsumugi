  "fixed_sql": [
    {
      "name": "installed_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installed_sources\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"api_version\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"installed_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"origin_kind\" TEXT NOT NULL, \"origin_url\" TEXT NULL, \"manifest_sha256\" TEXT NOT NULL, \"manifest_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "source_storage_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"source_storage_entries\" (\"source_id\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"source_id\", \"key\"));"
        }
      ]
    },
    {
      "name": "library_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_entries\" (\"source_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"cover\" TEXT NULL, \"cover_headers\" TEXT NULL, \"media_type\" TEXT NOT NULL, \"category\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"added_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "item_progress_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_progress_entries\" (\"source_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"cover\" TEXT NULL, \"cover_headers\" TEXT NULL, \"media_type\" TEXT NOT NULL, \"unit_id\" TEXT NOT NULL, \"unit_title\" TEXT NOT NULL, \"page\" INTEGER NULL, \"page_count\" INTEGER NULL, \"position\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "unit_progress_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"unit_progress_entries\" (\"source_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"unit_id\" TEXT NOT NULL, \"page\" INTEGER NULL, \"page_count\" INTEGER NULL, \"position\" INTEGER NULL, \"read\" INTEGER NOT NULL DEFAULT 0 CHECK (\"read\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_id\", \"item_id\", \"unit_id\"));"
