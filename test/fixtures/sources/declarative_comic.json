{
  "apiVersion": 1,
  "id": "com.example.comic",
  "name": "示例漫画",
  "type": "comic",
  "version": "1.0.0",
  "author": "tsumugi",
  "lang": "zh",
  "baseUrl": "https://example.com",
  "allowedHosts": ["*.example-cdn.com"],
  "headers": { "Referer": "https://example.com/" },
  "rateLimit": { "requests": 5, "perSeconds": 1 },
  "settings": [
    { "key": "quality", "label": "画质", "type": "select", "options": ["high", "low"], "default": "high" }
  ],
  "engine": "declarative",
  "someFutureField": true,
  "rules": {
    "search": {
      "request": { "url": "/search?q={{keyword}}&page={{page}}" },
      "list": "css:.result-item",
      "fields": { "id": "css:a@href", "title": "css:.title@text" }
    }
  }
}
