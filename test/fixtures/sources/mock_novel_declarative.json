{
  "apiVersion": 1,
  "id": "com.example.mock.novel.declarative",
  "name": "Mock 小说（声明式）",
  "type": "novel",
  "version": "1.0.0",
  "author": "tsumugi",
  "lang": "zh",
  "description": "虚构源，配合 tool/mock_server 手动调试与测试使用。",
  "baseUrl": "http://127.0.0.1:8080",
  "engine": "declarative",
  "rules": {
    "search": {
      "request": {
        "url": "/novel/search?q={{keyword}}"
      },
      "list": "css:.book",
      "fields": {
        "id": "css:h3 a@href",
        "title": "css:h3 a@text",
        "subtitle": "css:.writer@text",
        "tags": "css:.state@text[]"
      }
    },
    "detail": {
      "fields": {
        "title": "css:h1@text",
        "author": "css:.writer@text",
        "description": "css:#intro@text"
      },
      "units": {
        "list": "css:.catalog dd",
        "fields": {
          "id": "css:a@href",
          "title": "css:a@text"
        }
      }
    },
    "content": {
      "text": "css:#content p@text[]",
      "nextPageId": "css:a.next@href"
    }
  }
}
