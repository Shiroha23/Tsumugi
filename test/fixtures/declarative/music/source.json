{
  "apiVersion": 1,
  "id": "com.example.music.demo",
  "name": "示例音乐站",
  "type": "music",
  "version": "1.0.0",
  "baseUrl": "https://music.example.com",
  "headers": { "Referer": "https://music.example.com/" },
  "engine": "declarative",
  "rules": {
    "content": {
      "request": { "url": "/api/song?id={{unitId}}" },
      "streams": "json:$.data.files[*].url[]",
      "lyrics": "json:$.data.lrc"
    }
  }
}
