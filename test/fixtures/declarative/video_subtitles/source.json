{
  "apiVersion": 1,
  "id": "com.example.video.subtitles",
  "name": "示例视频站（外挂字幕）",
  "type": "video",
  "version": "1.0.0",
  "baseUrl": "https://video.example.com",
  "allowedHosts": ["*.example-cdn.com"],
  "headers": { "Referer": "https://video.example.com/" },
  "engine": "declarative",
  "rules": {
    "content": {
      "request": { "url": "/play/{{unitId}}" },
      "streams": "css:video source@src[]",
      "subtitles": {
        "list": "css:video track",
        "fields": {
          "url": "xpath:@src",
          "lang": "xpath:@label",
          "format": "xpath:@data-format"
        },
        "charset": "big5"
      }
    }
  }
}
