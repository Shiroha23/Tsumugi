CREATE TRIGGER item_progress_entries_sync_delete AFTER DELETE ON item_progress_entries
  WHEN EXISTS (SELECT 1 FROM sync_state WHERE id = 1 AND applying = 0 AND server_url IS NOT NULL)
BEGIN
  INSERT OR REPLACE INTO sync_tombstones (collection, key1, key2, key3, deleted_at)
    VALUES ('itemProgress', OLD.source_id, OLD.item_id, '', CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
